# App
gamification=gamification
PORT=8005
ENVIRONMENT=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/techub?sslmode=require

# Redis (Upstash)
REDIS_URL=rediss://default:password@host:port

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# OpenAI (ai-service and cv-aggregator only)
OPENAI_API_KEY=sk-your-openai-api-key

# Pinecone (ai-service and opportunities only)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=techub-skills

# Stripe (payment service only)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Cloudflare R2 (cv-aggregator only)
CLOUDFLARE_R2_BUCKET=techub-files
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# GitHub OAuth (cv-aggregator only)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Stagehand/Browserbase (apply-agent only)
BROWSERBASE_API_KEY=your-browserbase-api-key
BROWSERBASE_PROJECT_ID=your-browserbase-project-id
