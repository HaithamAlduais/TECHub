# ============================================
# TECHub Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ============================================

# --- Neon PostgreSQL ---
DATABASE_URL=
DATABASE_URL_DEVELOP=

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_QUEUE_URL=
UPSTASH_REDIS_QUEUE_TOKEN=

# --- Firebase ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_SDK_JSON=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_SKILLS=techub-skills
PINECONE_INDEX_OPPORTUNITIES=techub-opportunities

# --- Cloudflare R2 ---
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=techub-uploads

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- App Config ---
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_CV_API_URL=http://localhost:8013

# --- Service Ports ---
CV_AGGREGATOR_PORT=8001
AI_SERVICE_PORT=8002
OPPORTUNITIES_PORT=8003
APPLY_AGENT_PORT=8004
GAMIFICATION_PORT=8005
NOTIFICATIONS_PORT=8006
PAYMENT_PORT=8007
